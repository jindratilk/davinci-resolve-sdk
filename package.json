{
  "name": "davinci-resolve-sdk-standalone-candidate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk"
  ],
  "scripts": {
    "build": "npm run build --workspace davinci-resolve-sdk",
