{
  "name": "cutagent-internal-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK and local native runtime for DaVinci Resolve",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "cutagentSdk": {
    "typescript": ">=5.7.0 <5.10.0",
    "moduleFormat": "esm",
    "browser": false
  },
  "exports": {
    ".": {
      "types": "./.types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./.types/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./schemas": {
      "types": "./.types/schemas/index.d.ts",
      "import": "./dist/schemas.js"
    },
    "./protocol": {
      "types": "./.types/protocol/index.d.ts",
      "import": "./dist/protocol.js"
    },
    "./preview/v0.1": {
      "types": "./.types/preview/v0.1.d.ts",
      "import": "./dist/preview-v0.1.js"
    },
    "./compatibility.json": "./compatibility.json",
    "./compatibility.schema.json": "./compatibility.schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./.types/index.d.ts",
  "files": [
    "dist/",
    ".types/",
    "compatibility.json",
    "compatibility.schema.json",
    "README.md",
    "LIFECYCLE.md",
    "LICENSE"
  ],
  "scripts": {
    "build:js": "node scripts/build-js.mjs",
    "build:types": "tsc -p tsconfig.types.json && node ../scripts/copy-declaration-inputs.mjs",
    "build": "npm run build:js && npm run build:types"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.11",
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.9",
    "typescript": ">=5.7.0 <5.10.0"
  },
  "private": true
}
