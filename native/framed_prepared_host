#!/usr/bin/env python3
"""Existing prepared host over bounded private binary frames owned by its parent."""
import json
import struct
import sys
from cutagent_cli.local_admission import validate_local_command
from cutagent_cli.prepared_action_host import run_prepared_action_host, MAXIMUM_FRAME_BYTES

class Reader:
    def readline(self, limit):
        header = sys.stdin.buffer.read(4)
        if not header: return ''
        if len(header) != 4: raise ValueError('Truncated private frame header.')
        length = struct.unpack('>I', header)[0]
        if length < 1 or length > MAXIMUM_FRAME_BYTES: raise ValueError('Private frame exceeds its bound.')
        payload = sys.stdin.buffer.read(length)
        if len(payload) != length: raise ValueError('Truncated private frame.')
        return payload.decode('utf-8')+'\n'
class Writer:
    def write(self, text):
        data = text.removesuffix('\n').encode('utf-8')
        if len(data) > MAXIMUM_FRAME_BYTES: raise ValueError('Private response exceeds its bound.')
        sys.stdout.buffer.write(struct.pack('>I',len(data))+data)
    def flush(self): sys.stdout.buffer.flush()

validate_local_command()
run_prepared_action_host(reader=Reader(), writer=Writer())
